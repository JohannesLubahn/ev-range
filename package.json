{
  "name": "ev-compare",
  "private": true,
  "version": "0.1.0",
  "description": "Compare electric cars in stress-case scenarios with a first-principles physics model",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/inline_build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import-ods": "python3 -I scripts/ods_to_csv.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
